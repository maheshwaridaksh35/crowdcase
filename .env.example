# Never commit real credentials or tokens.
# Current browser Twitch connection only uses the public Client ID.
TWITCH_CLIENT_ID=
TWITCH_REDIRECT_URI=http://localhost:3000/
TWITCH_BROADCASTER_LOGIN=
TWITCH_BROADCASTER_ID=

# Reserved for the planned production server-managed OAuth/session implementation.
# Store real values in the host's secret manager, not in the repository.
TWITCH_CLIENT_SECRET=
SESSION_SECRET=
APP_BASE_URL=http://localhost:3000

# The current prototype calls the platform-managed Base44 AI gateway and does not
# require an OPENAI_API_KEY in this file. If a separate AI provider is added,
# configure its secret server-side only.
