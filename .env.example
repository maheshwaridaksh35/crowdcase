# Copy this file to .env.local and replace placeholders with your Base44 app settings.
# These are public build-time app identifiers, not secrets.
VITE_BASE44_APP_ID=replace-with-your-base44-app-id
VITE_BASE44_APP_BASE_URL=https://your-app.base44.app
# Optional: set only when your Base44 app has a specific functions version.
VITE_BASE44_FUNCTIONS_VERSION=

# Twitch Client ID is entered in CrowdCase Settings in the browser.
# Never put a Twitch Client Secret or access token in a VITE_* variable.
